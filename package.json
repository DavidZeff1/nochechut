{
  "name": "nochechut-chugim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "נוכחות חוגים – גרעין אומץ עכו: attendance for after-school classes",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "emulators": "npx -y firebase-tools emulators:start --project demo-nochechut",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "import": "tsx scripts/import.ts",
    "images": "tsx scripts/process-images.ts",
    "add-user": "tsx scripts/add-user.ts"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "firebase-admin": "^14.5.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
