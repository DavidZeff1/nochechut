# Firebase web config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# "firebase" (default) or "memory" (demo data in the browser, no sign-in)
VITE_BACKEND=firebase
# Set to "true" to talk to the local Firebase emulators (npm run emulators)
VITE_USE_EMULATOR=false
