rules_version = '2';

// Roles live in users/{uid}.role: "admin" | "instructor".
// A person gets a users doc by being invited (invites/{email}) and then signing in.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function myProfilePath() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(myProfilePath()); }
    function role() { return get(myProfilePath()).data.role; }
    function isAdmin() { return hasProfile() && role() == 'admin'; }
    function isStaff() { return hasProfile() && role() in ['admin', 'instructor']; }
    function myEmail() { return request.auth.token.email.lower(); }
    function invitePath() { return /databases/$(db)/documents/invites/$(myEmail()); }

    match /courses/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // Instructors may add a student who walked into a session; only admins edit. Nobody deletes students.
    match /students/{id} {
      allow read, create: if isStaff();
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /enrollments/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /sessions/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /config/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // First sign-in: copy your own invite into your profile, with the invited role only.
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.email != null
        && exists(invitePath())
        && request.resource.data.role == get(invitePath()).data.role
        && request.resource.data.email == myEmail();
      allow update, delete: if isAdmin();
    }
    match /invites/{email} {
      allow read: if signedIn() && (isAdmin() || myEmail() == email);
      allow write: if isAdmin();
    }
  }
}
